s","tags":["Health"]}}},"info":{"title":"AI Treasury Agent API","description":"REST API for AI-powered Programmable Treasury Management on BNB Chain.\n\nFeatures:\n- Web3 Nonce & Signature Authentication\n- Treasury Management & On-chain Vault Integration\n- BNB & BEP-20 Live Balance Verification\n- Transaction Proposals & Approval Workflows\n- Rule Engine & Automated Limit Enforcement\n- AI Assistant with Grounded Treasury Insights & Anomaly Detection","version":"1.0","contact":{}},"tags":[],"servers":[],"components":{"securitySchemes":{"JWT-auth":{"scheme":"bearer","bearerFormat":"JWT","type":"http","name":"JWT","description":"Enter your JWT token obtained from /api/auth/verify","in":"header"}},"schemas":{"GetNonceDto":{"type":"object","properties":{"address":{"type":"string","description":"EVM wallet address to authenticate","example":"0x1234567890abcdef1234567890abcdef12345678"}},"required":["address"]},"VerifySignatureDto":{"type":"object","properties":{"address":{"type":"string","description":"EVM wallet address","example":"0x1234567890abcdef1234567890abcdef12345678"},"signature":{"type":"string","description":"Hex-encoded signature from personal_sign / signMessage","example":"0x..."},"message":{"type":"string","description":"Original sign-in message that was signed"}},"required":["address","signature","message"]},"UpdateUserDto":{"type":"object","properties":{"name":{"type":"string","example":"Alice Treasury"},"email":{"type":"string","example":"alice@example.com"},"avatarUrl":{"type":"string","example":"https://example.com/avatar.png"}}},"ConnectWalletDto":{"type":"object","properties":{"address":{"type":"string","example":"0x1234567890abcdef1234567890abcdef12345678"},"chainId":{"type":"number","example":97}},"required":["address"]},"CreateTreasuryDto":{"type":"object","properties":{"name":{"type":"string","example":"Company Operations Treasury"},"walletId":{"type":"string","description":"Wallet ID belonging to the user to associate as primary treasury wallet"},"contractAddress":{"type":"string","description":"TreasuryVault smart contract address on BNB Chain","example":"0xFc6E3Ec48AB20fA72D88cb7c985d85E23971105A"},"chainId":{"type":"number","example":97}},"required":["name"]},"UpdateTreasuryDto":{"type":"object","properties":{"name":{"type":"string","example":"Updated Treasury Name"},"contractAddress":{"type":"string","example":"0xFc6E3Ec48AB20fA72D88cb7c985d85E23971105A"},"isActive":{"type":"boolean","example":true}}},"AddAssetDto":{"type":"object","properties":{"tokenAddress":{"type":"string","description":"BEP-20 token address or 0x0 for native BNB","example":"0x337610d27c682E347C9cD60BE4B3b107C9d34dDd"}},"required":["tokenAddress"]},"ProposeTransactionDto":{"type":"object","properties":{"treasuryId":{"type":"string","description":"Treasury ID"},"toAddress":{"type":"string","description":"Target recipient address","example":"0x1234567890abcdef1234567890abcdef12345678"},"tokenAddress":{"type":"string","description":"Token address (default 0x0 for native BNB)","default":"0x0000000000000000000000000000000000000000"},"tokenSymbol":{"type":"string","example":"BNB"},"amount":{"type":"string","example":"1.5","description":"Amount in human-readable formatted units"},"type":{"type":"string","enum":["DEPOSIT","WITHDRAW","TRANSFER","APPROVAL","CONTRACT_EXECUTION"],"default":"TRANSFER"},"reason":{"type":"string","example":"Transfer funds for monthly server hosting"}},"required":["treasuryId","toAddress","amount"]},"RecordTransactionDto":{"type":"object","properties":{"treasuryId":{"type":"string","description":"Treasury ID"},"txHash":{"type":"string","description":"Confirmed or submitted transaction hash on BNB Chain","example":"0x1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef"},"fromAddress":{"type":"string","example":"0x1234567890abcdef1234567890abcdef12345678"},"toAddress":{"type":"string","example":"0xabcdef1234567890abcdef1234567890abcdef12"},"tokenAddress":{"type":"string","default":"0x0000000000000000000000000000000000000000"},"tokenSymbol":{"type":"string","example":"BNB"},"amount":{"type":"string","example":"0.25"},"type":{"type":"string","enum":["DEPOSIT","WITHDRAW","TRANSFER","APPROVAL","CONTRACT_EXECUTION"],"default":"TRANSFER"},"approvalId":{"type":"string","description":"Optional approval ID if executing an approved request"}},"required":["treasuryId","txHash","fromAddress","toAddress","amount"]},"ExecuteApprovalDto":{"type":"object","properties":{"txHash":{"type":"string","description":"Submitted blockchain transaction hash","example":"0x1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef"}},"required":["txHash"]},"CreateRuleDto":{"type":"object","properties":{"name":{"type":"string","example":"Large Outgoing Alert"},"description":{"type":"string","example":"Alerts when any transaction exceeds 5 BNB"},"type":{"type":"string","enum":["LOW_BALANCE","LARGE_TRANSACTION","SCHEDULED_TRANSFER","EXCESS_BALANCE","INCOMING_PAYMENT"],"example":"LARGE_TRANSACTION"},"condition":{"type":"object","example":{"threshold":"5.0","token":"BNB"},"description":"Condition parameters for rule evaluation"},"action":{"type":"object","example":{"notify":true,"createApproval":false},"description":"Action parameters when condition triggers"},"executionMode":{"type":"string","enum":["RECOMMEND","REQUIRE_APPROVAL","AUTOMATIC"],"default":"REQUIRE_APPROVAL"},"isActive":{"type":"boolean","default":true}},"required":["name","type","condition","action"]},"UpdateRuleDto":{"type":"object","properties":{"name":{"type":"string","example":"Updated Rule Name"},"description":{"type":"string"},"type":{"type":"string","enum":["LOW_BALANCE","LARGE_TRANSACTION","SCHEDULED_TRANSFER","EXCESS_BALANCE","INCOMING_PAYMENT"]},"condition":{"type":"object"},"action":{"type":"object"},"executionMode":{"type":"string","enum":["RECOMMEND","REQUIRE_APPROVAL","AUTOMATIC"]},"isActive":{"type":"boolean"}}},"AgentChatDto":{"type":"object","properties":{"treasuryId":{"type":"string","description":"Target T